#!/usr/bin/env php
<?php
/**
 * Stacey CMS Setup Script
 *
 * Run this after installing Stacey to set up the directory structure:
 *   vendor/bin/stacey-setup
 */

// Find autoloader
$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaderFound = false;
foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require_once $file;
        $autoloaderFound = true;
        break;
    }
}

if (!$autoloaderFound) {
    echo "Error: Could not find autoloader. Please run 'composer install' first.\n";
    exit(1);
}

use Stacey\Core\Config;
use Stacey\Composer\Setup;

echo "Setting up Stacey CMS...\n\n";

// Determine project root
$projectRoot = getcwd();
$vendorDir = null;
$staceyRoot = null;

// Check if we're in vendor/bin
if (str_contains(__DIR__, '/vendor/bin') || str_contains(__DIR__, '\\vendor\\bin')) {
    $vendorDir = dirname(__DIR__, 2);
    $projectRoot = dirname($vendorDir);
    $staceyRoot = $vendorDir . '/tasinttttttt/stacey';
} elseif (file_exists($projectRoot . '/vendor/tasinttttttt/stacey')) {
    $vendorDir = $projectRoot . '/vendor';
    $staceyRoot = $vendorDir . '/tasinttttttt/stacey';
} else {
    // Try to find vendor directory
    $vendorDir = $projectRoot . '/vendor';
    if (is_dir($vendorDir . '/tasinttttttt/stacey')) {
        $staceyRoot = $vendorDir . '/tasinttttttt/stacey';
    } else {
        echo "Error: Could not find Stacey installation.\n";
        exit(1);
    }
}

echo "Project root: {$projectRoot}\n";
echo "Stacey root: {$staceyRoot}\n\n";

// Create directories
$directories = ['content', 'templates', 'public', 'app/_cache'];
foreach ($directories as $dir) {
    $path = $projectRoot . '/' . $dir;
    
    if (is_dir($path)) {
        echo "  ✓ Directory already exists: {$dir}\n";
        continue;
    }
    
    if (!mkdir($path, 0755, true) && !is_dir($path)) {
        echo "  ✗ Failed to create directory: {$dir}\n";
        continue;
    }
    
    echo "  ✓ Created directory: {$dir}\n";
}

// Copy index.php
$indexPath = $projectRoot . '/index.php';
$sourcePath = $staceyRoot . '/index.php';

if (file_exists($indexPath)) {
    echo "  ✓ index.php already exists, skipping\n";
} elseif (!file_exists($sourcePath)) {
    echo "  ✗ Source index.php not found: {$sourcePath}\n";
} elseif (!copy($sourcePath, $indexPath)) {
    echo "  ✗ Failed to copy index.php\n";
} else {
    echo "  ✓ Created: index.php\n";
}

echo "\n✓ Stacey CMS setup complete!\n\n";
echo "Next steps:\n";
echo "  1. Create content files in the content/ directory\n";
echo "  2. Create templates in the templates/ directory\n";
echo "  3. Run: php -S localhost:8000 index.php\n";
echo "\nSee README.md for documentation.\n";
