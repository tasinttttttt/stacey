{
  "name": "kolber/stacey",
  "description": "A file-based content management system",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": "^8.3",
    "intervention/image": "^3.0",
    "symfony/yaml": "^7.0",
    "twig/twig": "^3.0",
    "michelf/php-markdown": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11",
    "phpstan/phpstan-strict-rules": "^1.6",
    "friendsofphp/php-cs-fixer": "^3.60",
    "rector/rector": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "Stacey\\Core\\": "app/",
      "Stacey\\Core\\Asset\\": "app/asset/",
      "Stacey\\Core\\Parser\\": "app/parsers/",
      "Stacey\\Core\\Lib\\": "app/lib/",
      "Stacey\\Extension\\": "extension/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stacey\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "fix": "php-cs-fixer fix",
    "fix-dry": "php-cs-fixer fix --dry-run --diff",
    "rector": "rector process",
    "rector-dry": "rector process --dry-run",
    "check": [
      "@test",
      "@analyse",
      "@fix-dry"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
